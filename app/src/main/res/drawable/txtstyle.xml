<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- بک‌گراند -->
    <solid android:color="#e78868"/>

    <!-- گوشه‌های گرد -->
    <corners android:radius="12dp"/>

    <!-- پدینگ داخلی -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp" />

    <!-- خط دور (Border) -->
    <stroke
        android:width="2dp"
        android:color="#4CAF50" />

</shape>